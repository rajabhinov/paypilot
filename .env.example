# --- PayPal (sandbox) ---------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > create an app.
# Leave empty to run with the built-in offline PayPal simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: the webhook ID shown after you add a webhook pointing at
# https://<your-host>/api/paypal/webhook (events: INVOICING.INVOICE.*).
# When set, every webhook's signature is verified with PayPal.
PAYPAL_WEBHOOK_ID=

# --- AI ------------------------------------------------------------------
# Any OpenAI-compatible chat-completions API with tool calling. Groq by default.
# Leave empty to use the offline rule-based parser.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- App -------------------------------------------------------------------
BUSINESS_NAME=Indiquer Global Service Pvt Ltd
DEFAULT_CURRENCY=USD
PORT=8787
DATA_FILE=./data/paypilot.json
SEED_SAMPLE_HISTORY=true
